# Server-side only. Leave unset for honest disconnected example mode.
ZEER_PREP_URL=
ZEER_PREP_TOKEN=
# Base URL, without /graphql suffix.
ZEER_CHEF_URL=
ZEER_CHEF_TOKEN=
# Optional bounded demo descriptor. Copy the matching examples/chef-hackathon/demo.json
# as a single JSON line. This target does not replace the observed checkpoint.
ZEER_CHEF_DEMO=
# Optional operator-provided description, displayed in the console.
ZEER_DEMO_LABEL=
# Set explicitly behind a public reverse proxy, for example https://your-domain.
ZEER_WEB_ORIGIN=
# Optional operator-only private transport. Set URL to ssh://prep or ssh://chef.
# Requires a dedicated read-only forced-command SSH account, never a root key.
ZEER_SSH_HOST=
ZEER_SSH_PORT=22
ZEER_SSH_USER=
ZEER_SSH_PRIVATE_KEY=
# SHA-256 hex fingerprint of the independently verified ed25519 host public key.
ZEER_SSH_HOST_KEY_SHA256=
